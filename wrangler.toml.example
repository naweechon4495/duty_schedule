# คัดลอกไฟล์นี้เป็น wrangler.toml แล้วเติมค่าจริง (wrangler.toml ถูก .gitignore ไว้ ไม่ขึ้น repo)
name = "nawee-duty-schedule"
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"
main = "src/worker.js"
compatibility_date = "2026-07-05"

[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = ["/auth/*", "/api/*"]

[vars]
# Web App URL ของ Apps Script (ลงท้ายด้วย /exec) ที่ได้จากการ Deploy apps_script_backend.gs
APPS_SCRIPT_URL = "https://script.google.com/macros/s/REPLACE_ME/exec"
# Channel ID จาก LINE Developers Console (ไม่ใช่ความลับ)
LINE_CHANNEL_ID = "REPLACE_ME"

# ค่าลับ (ห้ามใส่ในไฟล์นี้) ตั้งด้วยคำสั่ง `npx wrangler secret put <ชื่อ>`:
#   LINE_CHANNEL_SECRET  - จาก LINE Developers Console
#   SESSION_SECRET       - สตริงสุ่มยาวๆ ที่คุณกำหนดเอง สำหรับเซ็นชื่อ session JWT
#   APPS_SCRIPT_TOKEN    - ต้องตรงกับ SECRET_TOKEN ใน apps_script_backend.gs
